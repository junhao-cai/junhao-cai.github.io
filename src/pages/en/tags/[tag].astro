---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import TagDetailView from '../../../components/shell/TagDetailView.astro';
import { publishedPosts, collectTags, postsOfTag } from '../../../lib/tags';

export const getStaticPaths = (async () => {
  const posts = publishedPosts(await getCollection('posts'), 'en');
  return collectTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, posts: postsOfTag(posts, tag.slug) },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<TagDetailView lang="en" tag={tag} posts={posts} />
