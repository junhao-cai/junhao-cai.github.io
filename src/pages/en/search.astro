---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ENABLE_SEARCH } from '../../site.config';
import { useT } from '../../i18n';

const lang = 'en';
const t = useT(lang);

const pfBase = import.meta.env.BASE_URL + 'pagefind/';
const intro = ENABLE_SEARCH
  ? 'Type keywords below to search. The index is generated by Pagefind after each build.'
  : 'Search is not enabled on this site.';
---

<BaseLayout title={t('search.title')} description={t('search.title')} wide>
  <header class="post-head">
    <h1>{t('search.title')}</h1>
    <p class="muted" style="margin:.4rem 0 0">{intro}</p>
  </header>

  <div id="search" style="margin-top:1rem"></div>

  <link href={pfBase + 'pagefind-ui.css'} rel="stylesheet" />
  <script src={pfBase + 'pagefind-ui.js'} is:inline></script>

  <script is:inline>
    if (typeof window.PagefindUI !== 'undefined') {
      new window.PagefindUI({
        element: '#search',
        resetStyles: true,
        showImages: false,
        excerptLength: 30,
        placeholder: 'Search posts and papers...',
      });
    } else {
      document.getElementById('search').innerHTML =
        '<p class="muted">Pagefind index not generated yet. Run <code>npm run build</code>, then <code>npm run postbuild:search</code>.</p>';
    }
  </script>
</BaseLayout>
