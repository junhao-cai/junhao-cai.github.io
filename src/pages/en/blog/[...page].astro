---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BlogIndexView from '../../../components/shell/BlogIndexView.astro';
import { publishedPosts } from '../../../lib/tags';
import { PAGE_SIZE } from '../../../site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = publishedPosts(await getCollection('posts'), 'en');
  return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BlogIndexView lang="en" page={page} />
