---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostView from '../../../components/shell/PostView.astro';
import { publishedPosts, postLang } from '../../../lib/tags';

export async function getStaticPaths() {
  // 只出英文笔记；内容 id 为 en/<slug>，路由中去掉前缀 → /en/posts/<slug>/
  const posts = publishedPosts(await getCollection('posts')).filter((p) => postLang(p) === 'en');
  return posts.map((post, i) => ({
    params: { slug: post.id.replace(/^en\//, '') },
    props: {
      post,
      newer: posts[i - 1] as CollectionEntry<'posts'> | undefined,
      older: posts[i + 1] as CollectionEntry<'posts'> | undefined,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<PostView lang="en" post={post} newer={newer} older={older} headings={headings}>
  <Content />
</PostView>
