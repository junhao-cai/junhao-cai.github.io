---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostView from '../../components/shell/PostView.astro';
import { publishedPosts, postLang } from '../../lib/tags';
import type { Lang } from '../../i18n';

export async function getStaticPaths() {
  // 中文站只出中文笔记；英文笔记由 /en/posts/ 下的同名页面生成，避免双 URL
  const posts = publishedPosts(await getCollection('posts')).filter((p) => postLang(p) === 'zh');
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] as CollectionEntry<'posts'> | undefined,
      older: posts[i + 1] as CollectionEntry<'posts'> | undefined,
    },
  }));
}
interface Props {
  post: CollectionEntry<'posts'>;
  newer?: CollectionEntry<'posts'>;
  older?: CollectionEntry<'posts'>;
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

const lang: Lang = postLang(post);
---

<PostView lang={lang} post={post} newer={newer} older={older} headings={headings}>
  <Content />
</PostView>
