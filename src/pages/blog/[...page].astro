---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BlogIndexView from '../../components/shell/BlogIndexView.astro';
import { publishedPosts } from '../../lib/tags';
import { PAGE_SIZE } from '../../site.config';
import { getLangFromUrl } from '../../i18n';

export const getStaticPaths = (async ({ paginate }) => {
  const lang = 'zh';
  const posts = publishedPosts(await getCollection('posts'), lang);
  return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<BlogIndexView lang={lang} page={page} />
