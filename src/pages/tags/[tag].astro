---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import TagDetailView from '../../components/shell/TagDetailView.astro';
import { publishedPosts, collectTags, postsOfTag } from '../../lib/tags';
import { getLangFromUrl } from '../../i18n';

export const getStaticPaths = (async () => {
  // 中文站只列中文笔记的标签；英文站（/en/tags/…）由 en/ 下的同名页面生成
  const posts = publishedPosts(await getCollection('posts'), 'zh');
  return collectTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, posts: postsOfTag(posts, tag.slug) },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<TagDetailView lang={lang} tag={tag} posts={posts} />
