---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ENABLE_SEARCH } from '../site.config';
import { getLangFromUrl, useT } from '../i18n';
import { withBase } from '../lib/base';

const lang = getLangFromUrl(Astro.url);
const t = useT(lang);

// Pagefind 资源走 base.ts 的 withBase 收口（ADR-003）。
// i18n 文案经 #search 的 data-* 传入：define:vars 会强制 is:inline，导致 SPA 反复访问时
// astro:page-load 监听累积、PagefindUI 重复初始化，故脚本改为 module + data 属性。
const pfBase = withBase('pagefind/');

const intro = ENABLE_SEARCH
  ? (lang === 'en'
      ? 'Type keywords below to search. The index is generated by Pagefind after each build.'
      : '下方输入关键字开始检索。索引在每次构建后由 Pagefind 生成。')
  : (lang === 'en' ? 'Search is not enabled on this site.' : '该站点未启用搜索。');

const placeholder = lang === 'en' ? 'Search posts and papers...' : '搜索文章与论文...';
const notReady = lang === 'en'
  ? 'Pagefind index not generated yet. Run <code>npm run build</code>, then <code>npm run postbuild:search</code>.'
  : 'Pagefind 索引尚未生成：npm run build → npm run postbuild:search';
---

<BaseLayout title={t('search.title')} description={t('search.title')} wide noIndex>
  <header class="post-head">
    <h1>{t('search.title')}</h1>
    <p class="muted" style="margin:.4rem 0 0">{intro}</p>
  </header>

  <div id="search" style="margin-top:1rem" data-placeholder={placeholder} data-not-ready={notReady}></div>

  <link href={pfBase + 'pagefind-ui.css'} rel="stylesheet" />
  <script src={pfBase + 'pagefind-ui.js'} is:inline></script>

  <script>
    // ViewTransitions：module 脚本仅执行一次，经 astro:page-load 在每次导航后重初始化 PagefindUI。
    document.addEventListener('astro:page-load', () => {
      const el = document.getElementById('search');
      if (!el) return;
      const placeholder = el.dataset.placeholder ?? '';
      const notReady = el.dataset.notReady ?? '';
      const PF = (window as any).PagefindUI;
      if (typeof PF !== 'undefined') {
        new PF({
          element: '#search',
          resetStyles: true,
          showImages: false,
          excerptLength: 30,
          placeholder,
        });
      } else {
        el.innerHTML = '<p class="muted">' + notReady + '</p>';
      }
    });
  </script>
</BaseLayout>
