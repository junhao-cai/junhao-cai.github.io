---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ENABLE_SEARCH } from '../site.config';
import { getLangFromUrl, useT } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useT(lang);

// Astro 在 base 非根时会设置 BASE_URL（如 /repo/）。下方 script 用了 is:inline，
// 不会被 Astro 自动加 base 前缀，必须手动拼接，否则部署到子目录后 /pagefind 会 404。
const pfBase = import.meta.env.BASE_URL + 'pagefind/';

const intro = ENABLE_SEARCH
  ? (lang === 'en'
      ? 'Type keywords below to search. The index is generated by Pagefind after each build.'
      : '下方输入关键字开始检索。索引在每次构建后由 Pagefind 生成。')
  : (lang === 'en' ? 'Search is not enabled on this site.' : '该站点未启用搜索。');
---

<BaseLayout title={t('search.title')} description={t('search.title')} wide>
  <header class="post-head">
    <h1>{t('search.title')}</h1>
    <p class="muted" style="margin:.4rem 0 0">{intro}</p>
  </header>

  <div id="search" style="margin-top:1rem"></div>

  <link href={pfBase + 'pagefind-ui.css'} rel="stylesheet" />
  <script src={pfBase + 'pagefind-ui.js'} is:inline></script>

  <script
    is:inline
    define:vars={{ placeholder: lang === 'en' ? 'Search posts and papers...' : '搜索文章与论文...', notReady: t('search.indexMissing') }}
  >
    if (typeof window.PagefindUI !== 'undefined') {
      new window.PagefindUI({
        element: '#search',
        resetStyles: true,
        showImages: false,
        excerptLength: 30,
        placeholder: placeholder,
      });
    } else {
      document.getElementById('search').innerHTML =
        '<p class="muted">' + notReady + '：npm run build → npm run postbuild:search</p>';
    }
  </script>
</BaseLayout>
