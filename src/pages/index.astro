---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import Courses from '../components/Courses.astro';
import Icon from '../components/Icon.astro';
import Toc from '../components/Toc.astro';
import { IDENTIFIERS, CONTACT, RECENT_POSTS_COUNT, PROFILE, profile, news } from '../site.config';
import { PUBLICATIONS, SELECTED_PUBLICATIONS, publicationTags } from '../lib/publications';
import { cvData } from '../data/cv';
import { inlineMd, formatDate } from '../lib/inline';
import { url } from '../lib/url';
import { getLangFromUrl, useT, withLang } from '../i18n';
import { getCollection } from 'astro:content';
import { publishedPosts } from '../lib/tags';

const lang = getLangFromUrl(Astro.url);
const t = useT(lang);
const p = profile(lang);
const newsList = news(lang);
const cv = cvData(lang);

const posts = publishedPosts(await getCollection('posts'), lang);
const recent = posts.slice(0, RECENT_POSTS_COUNT);
const selected = (SELECTED_PUBLICATIONS.length ? SELECTED_PUBLICATIONS : PUBLICATIONS).slice(0, 4);
const contactLinks = CONTACT.filter((c) => c.href);
const tags = publicationTags().slice(0, 8);
const pubCount = PUBLICATIONS.length;

const tocItems = [
  ...(newsList.length > 0 ? [{ id: 'news', label: t('home.news') }] : []),
  { id: 'selected', label: t('home.selectedPubs') },
  { id: 'eduExp', label: t('home.eduExp') },
  ...(cv.courses.length > 0 ? [{ id: 'courses', label: t('home.courses') }] : []),
  ...(recent.length > 0 ? [{ id: 'recent', label: t('home.recentPosts') }] : []),
  ...(tags.length > 0 ? [{ id: 'keywords', label: t('home.keywords') }] : []),
  { id: 'contact', label: t('home.contact') },
];
---

<BaseLayout wide>
  <!-- ------------------------------------------------------------ 个人概览 -->
  <section class="hero">
    <img class="hero__avatar" src={url(PROFILE.avatar)} alt={p.name} width="132" height="132" />
    <div>
      <h1>
        {p.name}
        <span class="hero__name-en">{PROFILE.nameEn}</span>
      </h1>
      <p class="hero__affiliation">{p.affiliation}</p>
      <p class="hero__tagline">{p.tagline}</p>

      <div class="hero__bio">
        {p.bio.map((line) => <p set:html={inlineMd(line)} />)}
      </div>

      <div class="hero__cta">
        <a class="btn btn--primary" href={url(withLang('/cv', lang))}>{t('home.viewCv')}</a>
        <a class="btn" href={url(withLang('/publications', lang))}>{t('home.pubList')}</a>
        {
          Object.entries(IDENTIFIERS)
            .filter(([, href]) => href)
            .map(([label, href]) => (
              <a class="chip" href={href} target="_blank" rel="noopener me">
                {label}
              </a>
            ))
        }
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------- 双栏：主列 + 右侧栏（目录置顶，与关键词/联系方式一同固定） -->
  <div class="home-grid">
    <div class="home-main">
      <!-- 动态 -->
      {
        newsList.length > 0 && (
          <section class="section" id="news">
            <div class="section__head">
              <h2 class="section__title">{t('home.news')}</h2>
              <a class="section__more" href={url('/rss.xml')}>
                {t('home.rss')} →
              </a>
            </div>
            <ul class="news-list">
              {newsList.map((n) => (
                <li>
                  <span class="news__date">{n.date}</span>
                  <p class="news__text">
                    {n.text}
                    {n.href && (
                      <a href={n.href.startsWith('http') ? n.href : url(n.href)}>
                        {n.linkText ?? t('home.view')} →
                      </a>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- 精选论文 -->
      {
        selected.length > 0 && (
          <section class="section" id="selected">
            <div class="section__head">
              <h2 class="section__title">{t('home.selectedPubs')}</h2>
              <a class="section__more" href={url(withLang('/publications', lang))}>
                {t('home.allPubs', pubCount)} →
              </a>
            </div>
            <div>
              {selected.map((e) => (
                <PublicationItem entry={e} card />
              ))}
            </div>
          </section>
        )
      }

      <!-- 经历 -->
      <section class="section" id="eduExp">
        <div class="section__head">
          <h2 class="section__title">{t('home.eduExp')}</h2>
          <a class="section__more" href={url(withLang('/cv', lang)) + '#education'}>{t('home.fullCv')} →</a>
        </div>
        <ul class="timeline">
          {
            [...cv.experience, ...cv.education].map((it) => (
              <li>
                <div class="timeline__period">{it.period}</div>
                <div>
                  <div class="timeline__title" set:html={inlineMd(it.title)} />
                  {it.subtitle && <div class="timeline__subtitle" set:html={inlineMd(it.subtitle)} />}
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      {cv.courses.length > 0 && (
        <section class="section" id="courses">
          <div class="section__head">
            <h2 class="section__title">{t('home.courses')}</h2>
            <a class="section__more" href={url(withLang('/cv', lang)) + '#courses'}>{t('home.fullCv')} →</a>
          </div>
          <Courses items={cv.courses} lang={lang} semesterGroups />
        </section>
      )}
    </div>

    <aside class="home-side">
      <Toc class="home-toc" items={tocItems} title={t('post.toc')} />
      <!-- 最近笔记 -->
      {
        recent.length > 0 && (
          <section class="section" id="recent">
            <div class="section__head">
              <h2 class="section__title">{t('home.recentPosts')}</h2>
              <a class="section__more" href={url(withLang('/blog', lang))}>
                {t('home.all')} →
              </a>
            </div>
            <ul class="side-list">
              {recent.map((post) => (
                <li>
                  <a class="side-item" href={url(`/posts/${post.id}/`)}>
                    <div class="side-item__title">{post.data.title}</div>
                    <div class="side-item__meta">{formatDate(post.data.pubDate, 'short', lang)}</div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- 研究关键词 -->
      {
        tags.length > 0 && (
          <section class="section" id="keywords">
            <div class="section__head">
              <h2 class="section__title">{t('home.keywords')}</h2>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:.45rem">
              {tags.map((tag) => (
                <a
                  class="chip"
                  href={url(`${withLang('/publications', lang)}?tag=${encodeURIComponent(tag.tag)}`)}
                >
                  {tag.tag}
                  <span class="chip__count">{tag.count}</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- 联系方式 -->
      <section class="section" id="contact">
        <div class="section__head">
          <h2 class="section__title">{t('home.contact')}</h2>
        </div>
        <div class="contact-card">
          {
            contactLinks.map((c) =>
              c.href ? (
                <a href={c.href} title={c.value}>
                  <Icon name={c.icon} size={14} />
                  {c.value}
                </a>
              ) : (
                <span class="row">
                  <Icon name={c.icon} size={14} />
                  {c.value}
                </span>
              )
            )
          }
        </div>
      </section>
    </aside>
  </div>
</BaseLayout>
