---
interface Props {
  /**
   * 显式目录项。每项可带 level（3 表示 h3 子项，缩进显示）。
   */
  items?: { id: string; label: string; level?: number }[];
  /**
   * 自动从某选择器内抓取 h2/h3 生成目录（用于 markdown 渲染页，如关于页）。
   * 依赖 rehype-slug 给标题生成的 id。
   */
  fromSelector?: string;
  title: string;
  class?: string;
}
const { items = [], fromSelector, title, class: cls } = Astro.props;
const auto = Boolean(fromSelector);
---

<aside class:list={['cv-toc', cls]} aria-label={title} data-toc={auto ? 'auto' : 'static'} data-scope={fromSelector ?? ''}>
  <p class="cv-toc__title">{title}</p>
  <nav aria-label={title}>
    <ul>
      {items.map((i) => (
        <li class:list={[i.level === 3 ? 'is-sub' : '']}>
          <a href={`#${i.id}`} data-id={i.id}>{i.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<script>
  // 统一目录 scrollspy —— 修复「过短 / 末节栏目」无法正确高亮的问题。
  // 旧逻辑用 IntersectionObserver(rootMargin -70% / -70%)：短栏目永远进不了顶部 30% 带，故失效。
  // 现改为基于滚动位置的「最后一个越过阈值栏目即当前栏目」算法，并对触底强制激活末项。
  // 算法本体已抽至 src/lib/client/toc.ts（initToc，逐字迁移，禁止点击锁定），此处仅做初始化。
  import { initToc } from '../lib/client/toc';

  document.querySelectorAll<HTMLElement>('.cv-toc').forEach((root) => initToc(root));
</script>
