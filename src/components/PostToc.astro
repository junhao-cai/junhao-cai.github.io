---
/**
 * 桌面端粘性目录侧栏（≥1081px 显示），配合 IntersectionObserver 滚动高亮。
 * 移动端由 posts/[...slug].astro 里的 .post-toc（块级目录）兜底。
 */
import { getLangFromUrl, useT } from '../i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const t = useT(getLangFromUrl(Astro.url));
---

{
  items.length > 2 && (
    <nav class="toc-rail" aria-label={t('post.toc')}>
      <div class="toc-rail__title">{t('post.toc')}</div>
      <ol>
        {items.map((h) => (
          <li class={h.depth === 3 ? 'is-sub' : undefined}>
            <a href={`#${h.slug}`} data-toc-link>{h.text}</a>
          </li>
        ))}
      </ol>
      <div class="toc-rail__hint">{t('post.tocHint')}</div>
    </nav>
  )
}

<script>
  import { initPostToc } from '../lib/client/toc';

  // ViewTransitions：导航后 body 被替换，需经 astro:page-load 重初始化文章目录。
  // 本脚本为 module（仅执行一次），监听器注册一次、每次导航触发，无重复注册。
  document.addEventListener('astro:page-load', () => {
    initPostToc();
  });
</script>
