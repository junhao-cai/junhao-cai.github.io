---
import Icon from './Icon.astro';
---

<button
  class="theme-toggle"
  type="button"
  id="theme-toggle"
  aria-label="切换深浅色主题"
  title="切换深浅色主题"
>
  <Icon name="sun" class="icon-sun" />
  <Icon name="moon" class="icon-moon" />
</button>

<script is:inline>
  // 首屏前应用主题，避免闪白（parse 期同步执行，不依赖 astro:page-load）。
  // 主题状态契约：`.dark` 类 = 当前实际是否深色（运行时唯一事实源）；
  // data-theme 只在用户显式选择过时写入，用于压住 @media 的系统偏好回退。
  (() => {
    const apply = () => {
      const root = document.documentElement;
      let saved = null;
      try {
        saved = localStorage.getItem('theme');
      } catch {}
      root.classList.remove('dark');
      if (saved === 'dark' || saved === 'light') {
        root.dataset.theme = saved;
      } else {
        delete root.dataset.theme; // 未显式选择 → 交给 @media 跟随系统实时变化
      }
      if (
        saved === 'dark' ||
        (saved == null && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        root.classList.add('dark');
      }
    };
    apply();
    // ViewTransitions 换页时 swapRootAttributes() 会用新页面 <html> 的属性整体
    // 覆盖当前根元素（astro@5.18 dist/transitions/swap-functions.js），客户端写入
    // 的 data-theme / .dark 被冲掉 → 换页后回弹系统色（浅色用户变深色，且要点
    // 两次切换钮才回浅色：第一次只是把类加回去，视觉无变化）。内联脚本本身被
    // detectScriptExecuted 按内容去重、换页不会重跑，故在 after-swap（首帧绘制
    // 前触发）重放一次，无闪修复；apply 幂等，重复触发无害。
    document.addEventListener('astro:after-swap', apply);
  })();
</script>

<script>
  // ViewTransitions：导航后 #theme-toggle 被重建，经 astro:page-load 重接点击监听。
  // 注：data-theme/.dark 在换页时会被 Astro swapRootAttributes 冲掉，由上方内联
  // 脚本的 astro:after-swap 监听重放恢复——此处只负责点击切换，不重复应用主题。
  document.addEventListener('astro:page-load', () => {
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle('dark');
      const theme = isDark ? 'dark' : 'light';
      root.dataset.theme = theme;
      try {
        localStorage.setItem('theme', theme);
      } catch {}
    });
  });
</script>
