---
/**
 * PublicationsView —— 论文列表页整页视图（T-17 新增）。
 *
 * 来源页面：src/pages/publications.astro（zh）与 src/pages/en/publications.astro（en）。
 * 两页正文（统计 chips / pub-filter / 年份分组 / multi-hint / 筛选脚本 / 页脚）逐字相同，
 * 差异仅两处，参数化如下。
 *
 * lang 参数化点（传参即等价）：
 * 1. description：zh=`${p.name} 的论文列表，共 N 篇。`；en=`Publications of ${p.name} — N in total.`
 *    （zh 页原本就是 lang 三元，en 页为字面量；组件保留三元）。
 * 2. 页脚「简历页」后的分隔符：zh 页是全角『；』（无空格），en 页是 ASCII '; '
 *    （带空格）——真实文本差异，用 `{lang === 'en' ? '; ' : '；'}` 保留，
 *    不得统一成一种（会改渲染字节）。
 * 3. 站内链接（/cv.bib、seeCv→/cv/）两页本就同串（/cv.bib 全站共用、withLang('/cv', lang)
 *    对 en 产出 '/en/cv/' 与 en 页硬编码一致），无需参数化。
 *
 * 与 HTML 等价性有关的注意点：
 * - 【已知不可字节级等价点】页内 <script>（筛选交互 DOM 接线）：现状 zh/en 两页各自
 *   编译出内容相同但文件名不同的两个 chunk（dist 实测
 *   publications.astro_..._lang.CqOZfhIC.js 与 .BkMB6_9s.js）。T-18 两页共用本组件后
 *   合并为单一 chunk，页面 HTML 中 <script src> 文件名必变（DOM 与行为不变）。
 *   T-19 的 dist diff 断言须对这两页的 script src 行做规范化豁免。
 * - 脚本 import 路径已按 shell/ 目录深度调整为 '../../lib/client/filter'；
 *   导入的是同一模块，bundle 行为等价。
 * - data-stat/data-year/data-tag 按钮、aria-pressed 初值与内联样式顺序逐字保留
 *   （lib/client/filter.ts 按 DOM 结构取元素，结构不可变）。
 */
import PageShell from './PageShell.astro';
import PublicationItem from '../PublicationItem.astro';
import { PUBLICATIONS_YEARS, publicationTags, isSelfAuthor, selfIsCorresponding } from '../../lib/publications';
import { formatCitation } from '../../lib/bibtex';
import { loadProfile, loadPublications } from '../../lib/content';
import { url } from '../../lib/url';
import { useT, withLang, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const p = loadProfile(lang);
const PUBLICATIONS = loadPublications();

const years = PUBLICATIONS_YEARS;
const tags = publicationTags();
const selfFirstCount = PUBLICATIONS.filter((e) => e.authors[0] && isSelfAuthor(e.authors[0])).length;
const selfCorrCount = PUBLICATIONS.filter((e) => selfIsCorresponding(e)).length;

---

<PageShell
  title={t('pub.title')}
  description={lang === 'en'
    ? `Publications of ${p.name} — ${PUBLICATIONS.length} in total.`
    : `${p.name} 的论文列表，共 ${PUBLICATIONS.length} 篇。`}
  wide
>
  <header class="post-head">
    <h1>{t('pub.title')}</h1>
    <div class="post-meta">
      <button class="chip" type="button" data-stat="all" aria-pressed="true">
        {t('pub.statsTotal')} <strong style="color:var(--c-text)">{PUBLICATIONS.length}</strong>
      </button>
      <button class="chip" type="button" data-stat="first" aria-pressed="false">
        {t('pub.statsFirst')} <strong style="color:var(--c-text)">{selfFirstCount}</strong>
      </button>
      <button class="chip" type="button" data-stat="corr" aria-pressed="false">
        {t('pub.statsCorr')} <strong style="color:var(--c-text)">{selfCorrCount}</strong>
      </button>
      <a class="chip" href={url('/cv.bib')} download>{t('cv.downloadBib')}</a>
    </div>
  </header>

  {
    (years.length > 0 || tags.length > 0) && (
      <div class="pub-filter" id="pub-filter" style="margin-bottom:1.5rem">
        {
          years.length > 0 && (
            <div class="pub-filter__group">
              <span class="pub-filter__label">{t('pub.filterYear')}</span>
              <div style="display:flex;flex-wrap:wrap;gap:.45rem">
                <button class="chip" type="button" data-year="" aria-pressed="true">
                  {t('pub.filterAll')}
                </button>
                {years.map((y) => (
                  <button class="chip" type="button" data-year={y} aria-pressed="false">
                    {y}
                    <span class="chip__count">
                      {PUBLICATIONS.filter((e) => e.year === y).length}
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div class="pub-filter__group">
              <span class="pub-filter__label">{t('pub.filterTag')}</span>
              <div style="display:flex;flex-wrap:wrap;gap:.45rem">
                <button class="chip" type="button" data-tag="" aria-pressed="true">
                  {t('pub.filterAll')}
                </button>
                {tags.map((tag) => (
                  <button class="chip" type="button" data-tag={tag.tag} aria-pressed="false">
                    {tag.tag}
                    <span class="chip__count">{tag.count}</span>
                  </button>
                ))}
              </div>
            </div>
          )
        }
        <p class="pub-filter__hint muted small">{t('pub.multiHint')}</p>
      </div>
    )
  }

  {
    PUBLICATIONS.length === 0 ? (
      <div class="empty-state">{t('pub.none')}</div>
    ) : (
      years.map((year) => {
        const items = PUBLICATIONS.filter((e) => e.year === year);
        return (
          <section class="section" style="margin-top:2rem" data-year-group data-year={year}>
            <div class="section__head">
              <h2 class="section__title">{year}</h2>
              <span class="section__more muted">{t('pub.count', items.length)}</span>
            </div>
            <div>
              {items.map((e) => (
                <PublicationItem entry={e} />
              ))}
            </div>
          </section>
        );
      })
    )
  }

  <div id="multi-hint" class="floating-hint" role="status">{t('pub.multiHint')}</div>

  <script>
    // 论文筛选交互（Phase 2 抽取，ADR/client modules）：纯逻辑（URL 参数解析 + 匹配判定）
    // 已抽至 src/lib/client/filter.ts（行为锁定，双页共用）；此处仅保留 DOM 接线
    // （aria-pressed / 组显隐 / URL 回写 / Ctrl 提示），与旧内联脚本行为一致。
    import { parsePubSelection, matchYear, matchTag, matchStat } from '../../lib/client/filter';

    // 浮动提示（全局，仅注册一次）：按住 Ctrl/⌘ 时跟随鼠标显示。
    // 置于 module 顶层（非 page-load），随 SPA 导航保持单一监听；事件内惰性重查 #multi-hint，避免失效引用 / 监听累积。
    {
      let active = false;
      const move = (e: MouseEvent) => {
        if (!active) return;
        const h = document.getElementById('multi-hint');
        if (!h) return;
        h.style.left = e.clientX + 14 + 'px';
        h.style.top = e.clientY + 14 + 'px';
      };
      window.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.ctrlKey || e.metaKey) { active = true; const h = document.getElementById('multi-hint'); if (h) h.style.display = 'block'; }
      });
      window.addEventListener('keyup', (e: KeyboardEvent) => {
        if (!e.ctrlKey && !e.metaKey) { active = false; const h = document.getElementById('multi-hint'); if (h) h.style.display = 'none'; }
      });
      window.addEventListener('mousemove', move);
    }

    // ViewTransitions：导航到论文页后需重初始化筛选。module 仅执行一次，借 astro:page-load 每次触发。
    document.addEventListener('astro:page-load', () => {
      (() => {
      const filter = document.getElementById('pub-filter');
      const statChips = [...document.querySelectorAll<HTMLButtonElement>('button[data-stat]')];
      const yearChips = filter ? [...filter.querySelectorAll<HTMLButtonElement>('button[data-year]')] : [];
      const tagChips = filter ? [...filter.querySelectorAll<HTMLButtonElement>('button[data-tag]')] : [];
      const groups = [...document.querySelectorAll<HTMLElement>('[data-year-group]')];
      if (!groups.length) return;

      // 读取 URL：兼容首页 ?tag= 单标签，以及多选 ?tags= / ?years= / ?stat=
      const sel = parsePubSelection(new URLSearchParams(location.search));

      const apply = () => {
        for (const c of statChips) {
          const v = c.dataset.stat || 'all';
          c.setAttribute('aria-pressed', String(v === sel.stat));
        }
        for (const c of yearChips) {
          const v = c.dataset.year || '';
          c.setAttribute('aria-pressed', String(v === '' ? sel.years.size === 0 : sel.years.has(v)));
        }
        for (const c of tagChips) {
          const v = c.dataset.tag || '';
          c.setAttribute('aria-pressed', String(v === '' ? sel.tags.size === 0 : sel.tags.has(v)));
        }
        for (const g of groups) {
          let shown = 0;
          for (const a of g.querySelectorAll<HTMLElement>('[data-tags]')) {
            const ok = matchYear(a.dataset.year || '', sel) && matchTag(a.dataset.tags || '', sel) && matchStat(a.dataset.firstAuthor, a.dataset.corresponding, sel);
            a.style.display = ok ? '' : 'none';
            if (ok) shown++;
          }
          g.style.display = shown ? '' : 'none';
        }
        // 同步 URL（单值用易读形式，多选用管道分隔）
        const u = new URL(location.href);
        u.searchParams.delete('stat');
        if (sel.stat !== 'all') u.searchParams.set('stat', sel.stat);
        const sync = (multiKey: string, set: Set<string>, singleKey: string) => {
          u.searchParams.delete(multiKey);
          u.searchParams.delete(singleKey);
          if (set.size === 1) u.searchParams.set(singleKey, [...set][0]);
          else if (set.size > 1) u.searchParams.set(multiKey, [...set].join('|'));
        };
        sync('tags', sel.tags, 'tag');
        sync('years', sel.years, 'year');
        history.replaceState(null, '', u);
      };

      const toggle = (set: Set<string>, value: string, multi: boolean) => {
        if (value === '') { set.clear(); return; }
        if (multi) {
          if (set.has(value)) set.delete(value);
          else set.add(value);
        } else {
          if (set.has(value)) set.clear();
          else { set.clear(); set.add(value); }
        }
      };

      for (const c of statChips) {
        c.addEventListener('click', () => {
          sel.stat = c.dataset.stat || 'all';
          apply();
        });
      }
      for (const c of yearChips) {
        c.addEventListener('click', (e) => {
          toggle(sel.years, c.dataset.year || '', e.ctrlKey || e.metaKey);
          apply();
        });
      }
      for (const c of tagChips) {
        c.addEventListener('click', (e) => {
          toggle(sel.tags, c.dataset.tag || '', e.ctrlKey || e.metaKey);
          apply();
        });
      }

      apply();
    })();
    });
  </script>

  <p class="muted small" style="margin-top:2.5rem">
    {t('pub.seeCv')} <a href={url(withLang('/cv', lang))}>{t('pub.cvPage')}</a>{lang === 'en' ? '; ' : '；'}{t('pub.citeExample')}
  </p>
  {
    PUBLICATIONS.some((e) => e.corresponding.length > 0) && (
      <p class="small" style="color:var(--c-text-soft);margin-top:.4rem">
        <sup class="corr">†</sup> {t('pub.corrNote')}
      </p>
    )
  }
  {
    PUBLICATIONS[0] && (
      <p class="small" style="color:var(--c-text-soft)">
        {formatCitation(PUBLICATIONS[0], 'apa')}
      </p>
    )
  }
</PageShell>
