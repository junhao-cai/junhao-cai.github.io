---
import { SITE, NAV, ENABLE_SEARCH } from '../site.config';
import { url } from '../lib/url';
import { basePath } from '../lib/base';
import { getLangFromUrl, useT, withLang, type Lang } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import Icon from './Icon.astro';

const lang: Lang = getLangFromUrl(Astro.url);
const t = useT(lang);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
// base 派生走 Base Authority（base.ts）；不用 stripBase 重写 isActive——
// 项目站下首页项对全部 base 子路径 active 的现状行为必须原样保持
const base = basePath().replace(/\/+$/, '');

const isActive = (p: string) => {
  const target = (base + withLang(p, lang)).replace(/\/+$/, '') || '/';
  if (target === '/') return path === '/' || path === base;
  return path === target || path.startsWith(target + '/');
};
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={url(withLang('/', lang))}>{SITE.title.split('·')[0].trim()}</a>

    <nav class="site-nav" id="site-nav" aria-label={lang === 'en' ? 'Main navigation' : '主导航'}>
      {NAV.map((item) => (
        <a href={url(withLang(item.path, lang))} aria-current={isActive(item.path) ? 'page' : undefined}>
          {t(`nav.${item.key}` as any)}
        </a>
      ))}
    </nav>

    {
      ENABLE_SEARCH && (
        <button class="search-trigger" type="button" id="search-trigger" aria-label={t('action.searchHint')}>
          <Icon name="search" size={14} />
          <span class="search-trigger__label">{t('action.search')}</span>
          <kbd class="search-trigger__kbd" id="search-kbd">Ctrl K</kbd>
        </button>
      )
    }

    <LangToggle />
    <ThemeToggle />

    <button
      class="nav-toggle"
      type="button"
      id="nav-toggle"
      aria-label={lang === 'en' ? 'Open menu' : '打开菜单'}
      aria-controls="site-nav"
      aria-expanded="false"
    >
      <Icon name="menu" class="icon-menu" size={18} />
      <Icon name="x" class="icon-close" size={18} />
    </button>
  </div>
</header>

<script>
  // ViewTransitions：导航后 #search-kbd 可能被重建，经 astro:page-load 重接。
  document.addEventListener('astro:page-load', () => {
    if (/Mac|iPhone|iPad/i.test(navigator.userAgent)) {
      const __kbd = document.getElementById('search-kbd');
      if (__kbd) __kbd.textContent = '⌘K';
    }
  });
</script>

<script>
  // ViewTransitions：导航后 header 与 #nav-toggle 被重建，经 astro:page-load 重接交互。
  document.addEventListener('astro:page-load', function () {
    const btn = document.getElementById('nav-toggle');
    const header = document.querySelector('.site-header');
    const inner = document.querySelector('.site-header__inner');
    if (!btn || !header || !inner) return;
    const btnEl = btn as HTMLButtonElement;
    const headerEl = header as HTMLElement;
    const innerEl = inner as HTMLElement;
    const navEl = headerEl.querySelector('.site-nav') as HTMLElement | null;

    function setOpen(open: boolean) {
      headerEl.classList.toggle('nav-open', open);
      btnEl.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    btnEl.addEventListener('click', function (e) {
      e.stopPropagation();
      setOpen(!headerEl.classList.contains('nav-open'));
    });

    // 点击任意导航链接后收起面板
    headerEl.querySelectorAll('.site-nav a').forEach(function (a) {
      a.addEventListener('click', function () {
        setOpen(false);
      });
    });

    // Esc 收起
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });

    // 点击页面其它区域收起
    document.addEventListener('click', function (e) {
      const target = e.target as EventTarget | null;
      if (headerEl.classList.contains('nav-open') && !headerEl.contains(target as Node | null)) {
        setOpen(false);
      }
    });

    // 自适应折叠：当导航项实际放不下（内容宽度超出头部可用宽度）时，给 .site-header
    // 加 .nav-collapsed——横排标签栏收起为内联汉堡、点击展开下拉面板。阈值由内容决定，
    // 而非写死视口断点，后期新增导航标签会自动提前折叠。
    function navOverflows(): boolean {
      if (!navEl) return false;
      const navPrev = navEl.style.cssText;
      // 测量期间临时隐藏汉堡，使判定始终基于「展开态」这一种布局，
      // 避免汉堡显隐随状态变化导致阈值漂移、拖拽时反复横跳。
      const toggle = headerEl.querySelector('.nav-toggle') as HTMLElement | null;
      const togglePrev = toggle ? toggle.style.cssText : '';
      if (toggle) toggle.style.display = 'none';
      // 导航脱离文档流测自然宽：position:absolute + visibility:hidden。
      // 既不扰动右侧控件布局（无可见位移闪烁），又能拿到真实内容宽度。
      navEl.style.position = 'absolute';
      navEl.style.visibility = 'hidden';
      navEl.style.display = 'flex';
      navEl.style.flexDirection = 'row';
      navEl.style.flex = '0 0 auto';
      navEl.style.width = 'max-content';
      navEl.style.whiteSpace = 'nowrap';
      navEl.style.left = '0';
      navEl.style.top = '0';
      const navW = navEl.getBoundingClientRect().width;
      const gap = parseFloat(getComputedStyle(innerEl).gap || getComputedStyle(innerEl).columnGap || '0') || 0;
      // 其余控件（汉堡已隐藏、导航已离流）的实际占用宽度之和 + 它们之间的 flex 间隙。
      // 注意：不能用 innerEl.scrollWidth 当 othersW——导航离流后右侧控件不溢出容器，
      // scrollWidth 会被钳制成容器宽度（=clientWidth），导致 available 恒为负、永远折叠。
      let othersW = 0;
      let inFlow = 0;
      for (const child of Array.from(innerEl.children)) {
        if (child === navEl) continue;
        const w = (child as HTMLElement).getBoundingClientRect().width;
        if (w > 0) { othersW += w; inFlow++; }
      }
      othersW += gap * Math.max(0, inFlow - 1);
      // 导航可用宽度 = 头部内容宽 − 其余控件占用 − 一个相邻间隙
      const available = innerEl.clientWidth - othersW - gap;
      const overflow = navW > available + 1;
      navEl.style.cssText = navPrev;
      if (toggle) toggle.style.cssText = togglePrev;
      return overflow;
    }

    function updateNav() {
      if (!navEl || !headerEl.isConnected) return;
      const collapsed = navOverflows();
      headerEl.classList.toggle('nav-collapsed', collapsed);
      // 展开态下不允许残留展开面板
      if (!collapsed) setOpen(false);
    }

    // 视口变化（或字体加载改变宽度）时重算；rAF 节流避免抖动
    let raf = 0;
    window.addEventListener('resize', function () {
      if (raf) return;
      raf = requestAnimationFrame(function () {
        raf = 0;
        updateNav();
      });
    });

    updateNav();
    // 字体异步加载可能改变导航项宽度，加载完成后复核一次
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(updateNav);
    }
  });
</script>
